    "app/preferences-form/preferences-form.component.ts",
    "app/preferences-form/shared/index.ts",
    "app/services/weather.service.spec.ts",
    "app/services/weather.service.ts",
    "app/shared/index.ts",
    "app/warnings/index.ts",
    "app/warnings/shared/index.ts",
    "app/warnings/warnings.component.spec.ts",
    "app/warnings/warnings.component.ts",
    "app/weather-stats/index.ts",
    "app/weather-stats/shared/index.ts",
    "app/weather-stats/weather-stats.component.spec.ts",
    "app/weather-stats/weather-stats.component.ts",
    "app/weather.service.spec.ts",
    "app/weather.service.ts",
    "app/wind/index.ts",
    "app/wind/shared/index.ts",
    "app/wind/wind.component.spec.ts",
