    "app/current-weather/current-weather.component.ts",
    "app/current-weather/index.ts",
    "app/current-weather/shared/index.ts",
    "app/directives/make-it-bold.directive.spec.ts",
    "app/directives/make-it-bold.directive.ts",
    "app/entities/preferences.ts",
    "app/entities/stats.ts",
    "app/entities/weather.ts",
    "app/environment.ts",
    "app/forecast/forecast.component.spec.ts",
    "app/forecast/forecast.component.ts",
    "app/forecast/index.ts",
    "app/forecast/shared/index.ts",
    "app/home/home.component.spec.ts",
    "app/home/home.component.ts",
    "app/home/index.ts",
    "app/home/shared/index.ts",
    "app/index.ts",
    "app/pipe/wind-speed.pipe.spec.ts",
