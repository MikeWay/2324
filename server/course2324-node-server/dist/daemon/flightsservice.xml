<service>
	<id>flightsservice.exe</id>
	<name>Flights Service</name>
	<description>The nodejs.org example web server.</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>--harmony</argument>
	<argument>C:\course2324\server\course2324-node-server\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>C:\course2324\server\course2324-node-server\dist\bundle.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>Flights Service wrapper</argument>
	<argument>--grow</argument>
	<argument>0.25</argument>
	<argument>--wait</argument>
	<argument>1</argument>
	<argument>--maxrestarts</argument>
	<argument>3</argument>
	<argument>--abortonerror</argument>
	<argument>n</argument>
	<argument>--stopparentfirst</argument>
	<argument>undefined</argument>
	<logmode>rotate</logmode>
	<stoptimeout>30sec</stoptimeout>
	<serviceaccount>
		<domain>BAD-WOLF-WIN</domain>
		<user>LocalSystem</user>
		<password></password>
	</serviceaccount>
	<workingdirectory>C:\course2324\server\course2324-node-server</workingdirectory>
</service>