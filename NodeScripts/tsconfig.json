{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2015",
        "lib": [ "es2015", "dom" ],
        "types": [ "node" ],
        "noImplicitAny": false,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": [
        "node_modules"
    ]

}
