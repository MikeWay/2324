{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2015",
        "lib": [ "es2015" ],
        "noImplicitAny": false,
        "sourceMap": true,
        "outDir": "./dist",
        "moduleResolution": "node",
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": [
        "node_modules"
    ]

}
